# Copie para .env e ajuste. Todas as variáveis são opcionais.

# Servidor
WLEDADMIN_HOST=0.0.0.0
WLEDADMIN_PORT=8000
WLEDADMIN_LOG_LEVEL=INFO

# Onde ficam o banco SQLite (e, futuramente, backups/firmwares)
WLEDADMIN_DATA_DIR=./data

# Polling (segundos)
WLEDADMIN_POLL_INTERVAL=10
WLEDADMIN_POLL_CONCURRENCY=16
# Falhas seguidas até marcar offline (evita "piscar")
WLEDADMIN_OFFLINE_AFTER_FAILURES=2
# Dispositivos offline são consultados só a cada N ciclos
WLEDADMIN_OFFLINE_POLL_EVERY=6

# Timeouts HTTP para os dispositivos (segundos)
WLEDADMIN_HTTP_CONNECT_TIMEOUT=2
WLEDADMIN_HTTP_TIMEOUT=4

# Descoberta
WLEDADMIN_MDNS_ENABLED=true
# Faixas para a varredura (CIDR separado por vírgula); também editável na tela
WLEDADMIN_SCAN_SUBNETS=192.168.1.0/24
WLEDADMIN_SCAN_CONCURRENCY=32
WLEDADMIN_SCAN_TIMEOUT=1.5

# Firmware (OTA)
# Token do GitHub (opcional): sem ele a API permite 60 consultas/hora, o que costuma bastar
# porque a lista de releases fica em cache. Um token sem permissões extras é suficiente.
# WLEDADMIN_GITHUB_TOKEN=
WLEDADMIN_OTA_UPLOAD_TIMEOUT=240
WLEDADMIN_OTA_REBOOT_TIMEOUT=180
